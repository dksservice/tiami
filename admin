async function loadActivity(notify){
  try{
    const {data:cms}=await sb.from('comments').select('*').order('created_at',{ascending:false});
    const {data:lks}=await sb.from('likes').select('id,created_at,photo_id').order('created_at',{ascending:false});
    const comments=cms||[];const likes=lks||[];
    const feed=[];
    comments.forEach(c=>feed.push({type:'comment',time:c.created_at,photo_id:c.photo_id,author:c.author,message:c.message}));
    likes.forEach(l=>feed.push({type:'like',time:l.created_at,photo_id:l.photo_id}));
    feed.sort((a,b)=>new Date(b.time)-new Date(a.time));
    renderActivityFeed(feed);
    const seen=JSON.parse(localStorage.getItem('tiam_seen')||'{"likes":0,"comments":0}');
    const newLikes=Math.max(0,likes.length-seen.likes);
