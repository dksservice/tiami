    fig.innerHTML='<span class="tape"></span>'
      +(p.sticker?'<span class="sticker-badge">'+p.sticker+'</span>':'')
      +(p.fav?'<span class="fav-heart">❤️</span>':'')
      +'<div class="ph"><img loading="lazy" src="'+p.url+'" alt=""></div>'
      +'<div class="acts">'
        +'<button data-a="fav">'+(p.fav?'❤️':'🤍')+'</button>'
        +'<button data-a="tag">🏷</button>'
        +'<button data-a="del">🗑</button>'
      +'</div>'
      +'<figcaption><span class="cap" contenteditable="true" spellcheck="false">'+esc(p.caption||'')+'</span>'
      +'<span class="pdate">'+faDate(p.added_at)+'</span></figcaption>';
    fig.querySelector('.ph').addEventListener('click',()=>openLB(i));
    fig.querySelectorAll('.acts button').forEach(b=>b.onclick=async e=>{
      e.stopPropagation();
      const a=b.dataset.a;
      if(a==='fav'){p.fav=!p.fav;await sb.from('photos').update({fav:p.fav}).eq('id',p.id);render();}
      else if(a==='tag'){const ix=p.sticker?STICKERS.indexOf(p.sticker):-1;
        p.sticker=(ix+1>=STICKERS.length)?null:STICKERS[ix+1];
        await sb.from('photos').update({sticker:p.sticker}).eq('id',p.id);render();}
      else{
        await sb.storage.from(BUCKET).remove([p.path]);
        await sb.from('photos').delete().eq('id',p.id);
        photos=photos.filter(x=>x.id!==p.id);render();toast('🗑 حذف شد');
      }
    });
