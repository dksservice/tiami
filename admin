function ageStr(bd){
  const b=parseL(bd),n=new Date();
  let m=(n.getFullYear()-b.getFullYear())*12+(n.getMonth()-b.getMonth());
  let d=n.getDate()-b.getDate();
  if(d<0){m--;d+=new Date(n.getFullYear(),n.getMonth(),0).getDate();}
  if(m<0)return '';
  const y=Math.floor(m/12),mm=m%12;let t='🎂 ';
  if(y)t+=fa(y)+' سال و ';
  if(mm||y)t+=fa(mm)+' ماه و ';
  return t+fa(d)+' روزه · متولد '+parseL(bd).toLocaleDateString('fa-IR',{year:'numeric',month:'long',day:'numeric'});
}
