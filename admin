function processFile(f){return new Promise(res=>{
  const done=bmp=>{const w=bmp.width||bmp.naturalWidth,h=bmp.height||bmp.naturalHeight;
    const M=1400,s=Math.min(1,M/Math.max(w,h));
    const c=document.createElement('canvas');c.width=Math.max(1,Math.round(w*s));c.height=Math.max(1,Math.round(h*s));
    c.getContext('2d').drawImage(bmp,0,0,c.width,c.height);
    if(bmp.close)try{bmp.close()}catch(e){}
    c.toBlob(b=>res(b),'image/jpeg',.85);};
  createImageBitmap(f,{imageOrientation:'from-image'}).then(done).catch(()=>{
    const u=URL.createObjectURL(f);const im=new Image();
    im.onload=()=>{done(im);URL.revokeObjectURL(u);};im.onerror=()=>res(null);im.src=u;});
});}
async function uploadFiles(files){
  const list=[...files].filter(f=>f.type.startsWith('image/'));
  if(!list.length)return;
  let n=0;
  for(let i=0;i<list.length;i++){
    toast('📤 در حال آپلود عکس '+fa(i+1)+' از '+fa(list.length)+'…');
    const blob=await processFile(list[i]);
    if(!blob)continue;
    const id=(crypto.randomUUID?crypto.randomUUID():'p'+Date.now()+Math.random().toString(16).slice(2));
    const path=album.id+'/'+id+'.jpg';
    const {error}=await sb.storage.from(BUCKET).upload(path,blob,{contentType:'image/jpeg'});
    if(error){toast('خطا در آپلود 😢');continue;}
    const {data:{publicUrl}}=sb.storage.from(BUCKET).getPublicUrl(path);
    await sb.from('photos').insert({id,album_id:album.id,path,url:publicUrl,caption:'',added_at:new Date(Date.now()+i).toISOString()});
    n++;
  }
  if(n){toast('🎉 '+fa(n)+' عکس اضافه شد — الان بالای آلبوم و روی لینک زنده هم هست!');await loadPhotos();}
}
