<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>آلبوم تیام جان | نسخه‌ی زنده</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lalezar&family=Vazirmatn:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--ink:#123f3a;--ink-soft:#4c6b66;--teal:#14655b;--teal-l:#e3f2ee;--coral:#ff6b5e;--coral-d:#e8554a;--butter:#ffd34d;--butter-l:#fff3cd;}
*{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none!important}
body{font-family:'Vazirmatn',sans-serif;color:var(--ink);min-height:100vh;
  background:linear-gradient(160deg,#eaf6fd 0%,#f2fbf5 45%,#fdf8ef 100%);background-attachment:fixed;overflow-x:hidden;}
.dots{position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:radial-gradient(rgba(20,101,91,.09) 1.6px,transparent 1.6px);background-size:28px 28px;}
.sun{position:fixed;top:-46px;left:-46px;width:170px;height:170px;border-radius:50%;
  background:radial-gradient(circle,#ffe28a 0%,#ffd34d 60%,rgba(255,211,77,0) 72%);pointer-events:none;z-index:0;}
.bunting{position:relative;z-index:3;width:100%;display:flex;justify-content:center;gap:2px;
  padding:0 8px;border-top:3px solid #b98a4e;overflow:hidden;height:46px;}
.flag{width:34px;height:38px;clip-path:polygon(0 0,100% 0,50% 100%);
  transform-origin:top center;animation:sway 3s ease-in-out infinite alternate;flex-shrink:0;}
@keyframes sway{from{transform:rotate(-3deg)}to{transform:rotate(3deg)}}
.wrap{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding:20px 20px 60px;}
.panel{background:#fff;border-radius:22px;box-shadow:0 14px 34px rgba(18,63,58,.13);padding:2rem;max-width:640px;margin:40px auto;}
.panel h1{font-family:'Lalezar',cursive;font-weight:400;font-size:2.1rem;margin-bottom:.5rem;}
.panel p{color:var(--ink-soft);line-height:2.1;font-size:.92rem;}
.panel label{display:block;font-weight:700;font-size:.85rem;margin:1rem 0 .3rem;color:var(--teal);}
input[type=text],input[type=email],input[type=password],input[type=url]{font-family:inherit;width:100%;border:2px solid var(--teal-l);
  border-radius:12px;padding:.65rem .9rem;font-size:.93rem;color:var(--ink);background:#fff;}
input:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 4px rgba(20,101,91,.12);}
.btn{font-family:inherit;font-weight:800;border:0;cursor:pointer;border-radius:16px;
  padding:.85rem 1.5rem;font-size:1rem;transition:translate .2s,box-shadow .2s;
  display:inline-flex;align-items:center;gap:.5rem;}
.btn:active{translate:0 1px}
.btn:disabled{opacity:.6;cursor:wait}
.btn-p{background:linear-gradient(135deg,#ff8a5c,#ff6b5e);color:#fff;box-shadow:0 10px 24px rgba(255,107,94,.38);}
.btn-p:hover{translate:0 -3px}
.btn-gh{background:#24292f;color:#fff;}
.btn-gh:hover{translate:0 -3px}
.btn-g{background:#fff;border:2px solid #cfe4de;color:var(--teal);}
.btn-g:hover{translate:0 -2px;border-color:var(--teal)}
.btn-sm{padding:.5rem .9rem;font-size:.85rem;border-radius:12px;}
.setup-msg{margin-top:1rem;font-size:.88rem;line-height:1.9;padding:.7rem 1rem;border-radius:12px;display:none;}
.setup-msg.ok{display:block;background:#e8f7ee;color:#1d7a35;}
.setup-msg.err{display:block;background:#fdecea;color:#c0392b;word-break:break-word;}
.setup-msg.info{display:block;background:#eef4fb;color:#2c5f8a;}
.cleaned-url{font-size:.78rem;color:#8aa6a1;margin-top:.3rem;direction:ltr;text-align:left;}
.hero{padding:30px 0 6px;}
.kicker{display:inline-flex;align-items:center;gap:.5rem;background:#fff;border:2px solid var(--teal-l);
  color:var(--teal);font-weight:700;font-size:.85rem;padding:.35rem .95rem;border-radius:999px;}
h1.big{font-family:'Lalezar',cursive;font-weight:400;font-size:clamp(2.4rem,6vw,4rem);line-height:1.2;margin:.5rem 0 .2rem;}
h1.big .name{color:var(--coral-d);}
.age-badge{display:inline-flex;margin-top:.5rem;background:var(--butter-l);border:2px solid #f2c14e;color:#8a6100;
  padding:.4rem 1rem;border-radius:999px;font-weight:800;font-size:.88rem;flex-wrap:wrap;}
.topbar{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin:1.1rem 0;}
.topbar .grow{flex:1}
.user-chip{font-size:.78rem;background:var(--teal-l);color:var(--teal);border-radius:999px;padding:.35rem .85rem;font-weight:700;}
.live-panel{background:#fff;border:3px solid var(--teal);border-radius:22px;padding:1.2rem 1.4rem;
  margin-bottom:1.2rem;box-shadow:0 12px 30px rgba(20,101,91,.16);}
.live-panel>b{color:var(--teal);font-size:1.05rem;}
.lp-sub{color:var(--ink-soft);font-size:.85rem;margin:.4rem 0 .8rem;line-height:2;}
.lp-status{font-size:.9rem;font-weight:700;color:var(--teal);margin:.5rem 0;line-height:1.9;animation:pulse 1.4s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.55}}
.lp-status.ok{color:#1d7a35;animation:none;}
.lp-status.err{color:#c0392b;animation:none;}
.lp-result{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin:.6rem 0;}
.lp-result input{flex:1;min-width:170px;direction:ltr;text-align:left;font-family:inherit;
  border:2px solid #f2c14e;background:var(--butter-l);border-radius:12px;padding:.6rem .9rem;
  font-size:.8rem;color:#6b4c00;font-weight:700;}
.lp-note{font-size:.76rem;color:#8aa6a1;line-height:1.9;margin-top:.6rem;border-top:1px dashed #d7e7e2;padding-top:.6rem;}
.lp-tip{font-size:.8rem;color:#2c5f8a;background:#eef4fb;border-radius:12px;padding:.7rem 1rem;margin:.6rem 0;line-height:1.9;}
.gh-note{font-size:.76rem;color:#8aa6a1;line-height:1.9;margin-top:.3rem;}
.activity-panel{background:#fff;border:2px solid #f2c14e;border-radius:22px;padding:1.1rem 1.3rem;margin-bottom:1.2rem;box-shadow:0 10px 26px rgba(242,193,78,.14);}
.activity-panel>b{color:#8a6100;font-size:1rem;display:block;margin-bottom:.7rem;}
.act-item{display:flex;gap:.7rem;align-items:center;padding:.55rem 0;border-bottom:1px solid #f5efe0;}
.act-item:last-child{border-bottom:none}
.act-item img{width:48px;height:48px;object-fit:cover;border-radius:12px;flex-shrink:0;box-shadow:0 3px 8px rgba(0,0,0,.12);}
.act-txt{font-size:.84rem;line-height:1.7;color:var(--ink);}
.act-txt small{display:block;color:#a0956f;font-size:.7rem;}
.stats{display:flex;flex-wrap:wrap;gap:.55rem;margin:4px 0 10px;}
.stat{background:#fff;border:2px solid var(--teal-l);border-radius:999px;padding:.35rem .95rem;
  font-size:.85rem;font-weight:700;color:var(--ink-soft);}
.stat b{color:var(--teal);}
.toolbar{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:14px 0;}
.chip{font-family:inherit;border:2px solid #d7e7e2;background:#fff;border-radius:999px;
  padding:.42rem .95rem;cursor:pointer;font-weight:700;font-size:.88rem;color:#3a655e;transition:.2s;}
.chip:hover{translate:0 -2px;border-color:var(--teal);}
.chip.on{background:var(--teal);color:#fff;border-color:var(--teal);}
.toolbar .grow{flex:1;}
.sort-btn{font-family:inherit;background:var(--butter-l);border:2px solid #f2c14e;color:#8a6100;
  border-radius:999px;padding:.42rem .95rem;font-weight:700;font-size:.85rem;cursor:pointer;}
#drop{border:3px dashed #9fd0c6;border-radius:26px;background:rgba(255,255,255,.72);
  padding:1.8rem 1.5rem;text-align:center;cursor:pointer;transition:.25s;}
#drop:hover,body.dragging #drop{border-color:var(--coral);background:#fff6f1;}
#drop b{color:var(--teal);}
#gallery{columns:240px;column-gap:20px;margin-top:22px;}
.polaroid{background:#fff;padding:10px 10px 12px;border-radius:5px;margin:0 0 20px;
  break-inside:avoid;position:relative;box-shadow:0 8px 20px rgba(18,63,58,.13);
  rotate:var(--tilt,0deg);transition:rotate .35s,translate .35s,box-shadow .35s;}
.polaroid:hover{rotate:0deg;translate:0 -7px;box-shadow:0 20px 38px rgba(18,63,58,.22);z-index:2;}
.tape{position:absolute;top:-11px;left:50%;translate:-50% 0;width:88px;height:24px;
  background:var(--tape,#ffd34d);opacity:.85;rotate:-3deg;border-radius:2px;z-index:3;}
.ph{overflow:hidden;background:#eef4f2;position:relative;line-height:0;}
.ph img{width:100%;display:block;cursor:zoom-in;}
.sticker-badge{position:absolute;top:8px;right:8px;font-size:1.7rem;z-index:2;}
.fav-heart{position:absolute;top:8px;left:8px;font-size:1.2rem;z-index:2;}
.acts{position:absolute;bottom:10px;left:10px;display:flex;gap:5px;z-index:4;
  opacity:0;translate:0 8px;transition:.25s;}
.polaroid:hover .acts{opacity:1;translate:0 0;}
.acts button{width:32px;height:32px;border-radius:50%;border:0;background:#fffdf6;cursor:pointer;
  font-size:.95rem;box-shadow:0 3px 8px rgba(0,0,0,.22);transition:.15s;}
.acts button:hover{scale:1.18;}
figcaption{display:flex;justify-content:space-between;gap:8px;padding-top:11px;align-items:baseline;}
.cap{font-weight:600;font-size:.92rem;color:#214f49;flex:1;outline:none;line-height:1.7;
  border-bottom:1px dashed transparent;min-height:1.2em;}
.cap:focus{border-color:#f2b84b;background:#fffbe9;}
.cap:empty::before{content:'یه یادگاری بنویس…';color:#a9c3bd;font-weight:400;}
.pdate{font-size:.7rem;color:#8aa6a1;white-space:nowrap;}
.empty-msg{text-align:center;color:var(--ink-soft);padding:1.6rem;font-size:.92rem;}
#lb{position:fixed;inset:0;z-index:50;background:rgba(10,32,29,.92);
  display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;}
#lb img{max-width:min(88vw,860px);max-height:52vh;border-radius:8px;background:#fff;padding:10px;
  box-shadow:0 30px 70px rgba(0,0,0,.5);}
.lb-cap{color:#fff;margin-top:12px;font-weight:700;font-size:1.05rem;text-align:center;}
.lb-meta{color:#9fc5be;font-size:.85rem;margin-top:.3rem;}
.lb-x{position:absolute;top:18px;left:18px;width:46px;height:46px;border-radius:50%;
  border:0;background:#fff;font-size:1.2rem;cursor:pointer;}
.lb-nav{position:absolute;top:40%;translate:0 -50%;width:52px;height:52px;border-radius:50%;border:0;
  background:#fff;font-size:1.5rem;cursor:pointer;}
.lb-prev{right:18px}.lb-next{left:18px}
.lb-count{color:#9fc5be;font-size:.8rem;font-weight:700;margin-top:.4rem;}
#toasts{position:fixed;bottom:22px;left:50%;translate:-50% 0;z-index:80;display:flex;
  flex-direction:column;gap:.5rem;align-items:center;}
.toast{background:var(--ink);color:#fff;padding:.7rem 1.3rem;border-radius:14px;font-size:.9rem;
  font-weight:600;box-shadow:0 12px 30px rgba(0,0,0,.3);max-width:90vw;text-align:center;}
footer{margin-top:50px;text-align:center;color:#7a9790;font-size:.85rem;}
@media(max-width:820px){.panel{padding:1.4rem;margin:20px auto;}}
</style>
</head>
<body>
<div class="dots"></div><div class="sun"></div>
<div class="bunting" id="bunting"></div>

<div class="wrap">
  <section id="scrSetup" hidden>
    <div class="panel">
      <h1>☁️ اتصال به فضای ابری</h1>
      <p><b>راهنما:</b> در کادر اول <b>آدرس مرورگرت</b> را از داشبورد سوپابیس پیست کن؛ خودم آدرس درست را می‌سازم. کلید را هم از <b>API Keys → Publishable key</b> بگیر.</p>
      <label>آدرس (از داشبورد سوپابیس کپی کن)</label>
      <input type="text" id="cfgUrl" placeholder="https://supabase.com/dashboard/project/... یا https://xxx.supabase.co" dir="ltr">
      <div class="cleaned-url" id="cleanedUrl"></div>
      <label>کلید (Publishable key)</label>
      <input type="text" id="cfgKey" placeholder="sb_publishable_..." dir="ltr">
      <div style="margin-top:1.2rem;">
        <button class="btn btn-p" id="btnSaveCfg">💾 ذخیره و تست اتصال</button>
      </div>
      <div class="setup-msg" id="setupMsg"></div>
    </div>
  </section>

  <section id="scrLogin" hidden>
    <div class="panel">
      <h1>🔑 ورود به آلبوم</h1>
      <p>ایمیل و رمز عبورت را بزن. <b>بار اول</b> حساب ساخته می‌شود، <b>دفعات بعد</b> فقط وارد می‌شوی — بدون ایمیل و کد. 😊</p>
      <label>ایمیل تو</label>
      <input type="email" id="emailInp" placeholder="you@gmail.com" dir="ltr">
      <label>رمز عبور (حداقل ۶ حرف)</label>
      <input type="password" id="passInp" placeholder="••••••••" dir="ltr">
      <div style="margin-top:1.2rem;">
        <button class="btn btn-p" id="btnLogin">🔑 ورود / ساخت حساب</button>
      </div>
      <div id="loginMsg" style="margin-top:.9rem;font-size:.86rem;line-height:1.9;"></div>
      <p style="margin-top:1.2rem;font-size:.78rem;">متصل به: <span id="loginHost" style="font-weight:700;color:var(--teal);"></span>
      · <a href="#" id="btnResetCfg" style="color:#c0392b;">تغییر تنظیمات</a></p>
    </div>
  </section>

  <section id="scrMain" hidden>
    <header class="hero">
      <span class="kicker">🍼 آلبوم زنده‌ی تیام جان ☁️</span>
      <h1 class="big">قصه‌ی عکسیِ <span class="name">تیام جان</span></h1>
      <span class="age-badge" id="ageBadge" hidden></span>
    </header>
    <div class="topbar">
      <button class="btn btn-p" id="btnUpload">📷 افزودن عکس</button>
      <div class="grow"></div>
      <span class="user-chip" id="userChip"></span>
      <button class="btn btn-g btn-sm" id="btnLogout">خروج</button>
    </div>
    <div class="live-panel">
      <b>🔗 لینک زنده و همیشگی</b>
      <p class="lp-sub">هر عکسی آپلود کنی همان لحظه روی لینک دیده می‌شود (جدیدها بالا). فامیل لایک ❤️ و یادگاری 🌸 می‌ذارن و تو اعلان می‌گیری.</p>
      <button class="btn btn-p" id="btnBuildLive">🔗 ساخت لینک زنده</button>
      <div id="liveStatus" class="lp-status" hidden></div>
      <div id="liveResult" class="lp-result" hidden>
        <input readonly id="liveOut" dir="ltr">
        <button class="btn btn-p btn-sm" id="btnCopyLive">📋 کپی</button>
        <button class="btn btn-g btn-sm" id="btnOpenLive">👀 چک کردن</button>
      </div>
      <div class="lp-tip">💡 برای انتشار از <b>GitHub Pages</b> استفاده کن: دکمه‌ی زیر کد آلبوم را کپی می‌کند، بعد در GitHub (فایل index.html) پیستش می‌کنی.</div>
      <div style="display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.4rem;">
        <button class="btn btn-gh btn-sm" id="btnCopyGitHub">📋 کپی کد برای GitHub</button>
      </div>
      <div class="gh-note">بعد از کپی، در GitHub فایل <span dir="ltr" style="font-weight:bold;">index.html</span> را باز کن، مداد ✏️ را بزن، کد قبلی را پاک کن و کد جدید را پیست کن و Commit بزن.</div>
      <p class="lp-note">🔓 هر کسی لینک را داشته باشد آلبوم را می‌بیند و لایک/یادگاری می‌گذارد.</p>
    </div>

    <div class="live-panel" style="border-color:#7cc576;">
      <b style="color:#3f7d3a;">📱 آپلود عکس با موبایل</b>
      <p class="lp-sub">با این لینک، صفحه‌ی مدیریت را روی گوشی باز می‌کنی و مستقیم از گالری یا دوربین گوشی عکس می‌گذاری.</p>
      <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
        <button class="btn btn-p btn-sm" id="btnMobileLink">📱 ساخت لینک ورود با موبایل</button>
      </div>
      <div id="mobileLinkBox" class="lp-result" hidden>
        <input readonly id="mobileLinkOut" dir="ltr">
        <button class="btn btn-p btn-sm" id="btnCopyMobile">📋 کپی</button>
      </div>
      <div class="gh-note" id="mobileNote" hidden>این لینک را برای گوشی خودت بفرست (مثلاً توی تلگرام/واتساپ) و روی گوشی بازش کن. خودکار تنظیم می‌شود و فقط ایمیل+رمز می‌خواهد.</div>
    </div>

    <div class="activity-panel" id="activityPanel" hidden>
      <b>🔔 فعالیت‌های اخیر</b>
      <div id="activityFeed"></div>
    </div>

    <div class="stats" id="stats"></div>
    <div class="toolbar">
      <div id="chips" style="display:flex;gap:.5rem;flex-wrap:wrap;"></div>
      <div class="grow"></div>
      <button class="sort-btn" id="btnSort">⏳ چیدمان: جدید ← قدیم</button>
    </div>
    <div id="drop">☁️ عکس‌ها را <b>همین‌جا رها کن</b> یا کلیک کن · Ctrl+V هم کار می‌کند</div>
    <main id="gallery"></main>
    <div class="empty-msg" id="emptyMsg" hidden>هنوز عکسی در آلبوم نیست — اولین خاطره را اضافه کن! 🧸</div>
    <footer>ساخته‌شده با ❤ برای تیام جان · عکس‌ها در فضای ابری نگهداری می‌شوند</footer>
  </section>
</div>

<div id="lb" hidden>
  <button class="lb-x" id="lbClose">✕</button>
  <button class="lb-nav lb-prev" id="lbPrev">‹</button>
  <button class="lb-nav lb-next" id="lbNext">›</button>
  <img id="lbImg" alt="">
  <div class="lb-cap" id="lbCap"></div>
  <div class="lb-meta" id="lbMeta"></div>
  <div class="lb-count" id="lbCount"></div>
</div>

<div id="toasts"></div>
<input type="file" id="fileInput" accept="image/*" multiple hidden>

<script>
'use strict';
// ===== تنظیم خودکار از لینک جادویی موبایل =====
(function(){
  if(location.hash && location.hash.indexOf('#cfg=')===0){
    try{
      var raw=location.hash.substring(5);
      var json=decodeURIComponent(escape(atob(raw)));
      var c=JSON.parse(json);
      if(c && c.url && c.anon){
        localStorage.setItem('tiam_sb_cfg',JSON.stringify({url:c.url,anon:c.anon}));
      }
    }catch(e){}
    location.replace(location.href.split('#')[0]);
  }
})();

const $=s=>document.querySelector(s);
const fa=n=>Number(n).toLocaleString('fa-IR');
const BUCKET='album-photos';
const BDAY='2026-07-04';
const STICKERS=['🍼','😴','🛁','🎂','🎈','🧸','⭐','🌸'];
const TAPES=['rgba(255,211,77,.8)','rgba(255,107,94,.65)','rgba(98,182,232,.6)','rgba(255,180,194,.75)','rgba(124,197,118,.6)'];
const FLAGS=['#ff6b5e','#ffd34d','#62b6e8','#ffb4c2','#7cc576'];
let cfg=null,sb=null,user=null,album=null,photos=[],visible=[],view='all',sortAsc=false,lightIdx=-1;

function cleanSupaUrl(input){
  input=(input||'').trim().replace(/\/+$/,'');
  let m=input.match(/https?:\/\/([a-zA-Z0-9-]+)\.supabase\.co/);
  if(m)return 'https://'+m[1]+'.supabase.co';
  m=input.match(/supabase\.com\/dashboard\/project\/([a-zA-Z0-9]+)/);
  if(m)return 'https://'+m[1]+'.supabase.co';
  if(/^[a-zA-Z0-9_-]{10,}$/.test(input))return 'https://'+input+'.supabase.co';
  return input;
}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function timeAgo(t){
  const s=Math.floor((Date.now()-new Date(t))/1000);
  if(s<60)return 'همین الان';
  if(s<3600)return fa(Math.floor(s/60))+' دقیقه پیش';
  if(s<86400)return fa(Math.floor(s/3600))+' ساعت پیش';
  return fa(Math.floor(s/86400))+' روز پیش';
}

function toast(msg){const t=document.createElement('div');t.className='toast';t.textContent=msg;
  $('#toasts').appendChild(t);setTimeout(()=>{t.style.opacity='0';t.style.transition='.4s';setTimeout(()=>t.remove(),400);},4200);}
function show(id){['scrSetup','scrLogin','scrMain'].forEach(s=>$('#'+s).hidden=true);$('#'+id).hidden=false;window.scrollTo(0,0);}
